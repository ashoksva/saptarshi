# OpenAI-compatible endpoint for the hosted Hugging Face model (vLLM/TGI).
# Local default: the stub LLM in docker-compose.
MODEL_BASE_URL=http://127.0.0.1:8001/v1
MODEL_API_KEY=not-needed-for-stub
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_NAME=saptarshi

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Next.js (browser talks to FastAPI on the host)
NEXT_PUBLIC_API_URL=http://localhost:8000
